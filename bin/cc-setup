#!/usr/bin/env bash
# cc-setup: Configure Claude Code tools (hooks + settings + skills + CLAUDE.md) in a project.
# Usage: cc-setup [project_path] [--vault] [--factory] [--no-factory] [--reset-terminals] [--devcontainer [--cloud aws|gcp|none] [--firewall on|off]]
#   --factory / --no-factory  the factory is scaffolded by default; --no-factory opts out (marker .claude/no-factory)
#   --reset-terminals  replace the recorded terminal hosts (control mode) with this terminal's, instead of adding it
set -euo pipefail

CC_TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROJECT_DIR=""
WITH_DEVCONTAINER=0
WITH_VAULT=0
WITH_FACTORY=0
NO_FACTORY=0
RESET_TERMINALS=0
DEVCONTAINER_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --vault) WITH_VAULT=1; shift ;;
        --factory) WITH_FACTORY=1; shift ;;
        --no-factory) NO_FACTORY=1; shift ;;
        --reset-terminals) RESET_TERMINALS=1; shift ;;
        --devcontainer) WITH_DEVCONTAINER=1; shift ;;
        --cloud|--cloud=*|--firewall|--firewall=*|--force)
            DEVCONTAINER_ARGS+=("$1")
            # Consume the value too if it's a separate arg
            case "$1" in
                --cloud|--firewall) DEVCONTAINER_ARGS+=("${2:-}"); shift 2 ;;
                *) shift ;;
            esac
            ;;
        -*) echo "Unknown flag: $1" >&2; exit 1 ;;
        *)  PROJECT_DIR="$1"; shift ;;
    esac
done

if (( WITH_FACTORY && NO_FACTORY )); then
    echo "Error: --factory and --no-factory contradict each other." >&2
    exit 1
fi

PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"
PROJECT_DIR="$(realpath "$PROJECT_DIR")"

# ── Validation ──────────────────────────────────────────────────────────────
if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "Error: '$PROJECT_DIR' does not exist." >&2
    exit 1
fi

echo "Setting up Claude Code tools in: $PROJECT_DIR"
echo ""

# cc_tool no longer manages .mcp.json — it ships no MCP server of its own.
# A project that wants one adds it directly, or with `claude mcp add`.

# ── 1. Hook scripts ───────────────────────────────────────────────────────────
mkdir -p "$PROJECT_DIR/.claude/hooks"
# Copy each hook unless the project's copy carries local edits (its content
# matches no version cc_tool has ever shipped) -- same blob-id test as the
# skill refresh. The typecheck hook's own docstring tells users to raise its
# TIMEOUT; an unconditional copy silently undid that on every update.
python3 - "$CC_TOOL_DIR" "$PROJECT_DIR" <<'EOF'
import hashlib, shutil, subprocess, sys
from pathlib import Path

cc_tool, project = Path(sys.argv[1]), Path(sys.argv[2])
tdir, hdir = cc_tool / "templates" / "hooks", project / ".claude" / "hooks"
PREFIX = "templates/hooks/"


def git(*args):
    return subprocess.run(["git", "-C", str(cc_tool), *args], capture_output=True, text=True).stdout


def blob_oid(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


shipped = {}
for commit in git("log", "--all", "--format=%H", "--", PREFIX).split():
    for line in git("ls-tree", "-r", commit, "--", PREFIX).splitlines():
        meta, _, path = line.partition("\t")
        parts = meta.split()
        if len(parts) == 3 and parts[1] == "blob" and path.startswith(PREFIX):
            shipped.setdefault(path[len(PREFIX):], set()).add(parts[2])

kept = []
for src in sorted(tdir.iterdir()):
    if not src.is_file() or src.suffix not in (".py", ".sh"):
        continue
    dst = hdir / src.name
    if dst.is_file():
        have = blob_oid(dst.read_bytes())
        if have == blob_oid(src.read_bytes()):
            continue
        if have not in shipped.get(src.name, set()):
            kept.append(src.name)
            continue
    shutil.copy2(src, dst)
if kept:
    print("  • kept locally-modified hook(s), not overwritten: " + ", ".join(kept))
    print("    (delete the project copy to adopt the current template)")
EOF
find "$PROJECT_DIR/.claude/hooks" -maxdepth 1 -name "*.sh" -exec chmod +x {} \;

# Pin this cc_tool checkout for the dash-control hook: it trusts a control-mode
# dashboard only when that process runs <this root>/bin/cc-dash, so a copy of
# cc_tool (or a fake one) an agent starts cannot answer for the dashboard.
# .claude/ is a protected path in Claude Code: an agent cannot rewrite this
# file, or the hooks beside it, without your approval. cc-update-project
# refreshes it (it runs this script).
# Beside it, cc_dash_manifest.json: the sha256 of cc-dash's code in this checkout
# (bin/cc-dash, cc_procs.py, lib/cc_dash/), and the real path and sha256 of the
# python3 cc-dash runs on. The hook trusts a dashboard only while that code is
# unchanged and only when the process runs that very interpreter, so a Bash edit
# of the checkout cannot vouch for itself and a binary merely named python3 is
# not trusted. After a `git pull` of cc_tool, or a python3 upgrade,
# cc-update-project re-records it. bin/cc-dash re-executes the interpreter its
# shebang resolved, so run cc-setup with the python3 you run cc-dash with.
# The manifest also lists your terminal programs (terminal_hosts): what holds the
# terminal cc-setup runs in, plus CC_DASH_TERMINALS (only beside a detected one). The control code is shown
# only on a terminal one of them holds.
# And the project goes into ${XDG_STATE_HOME:-~/.local/state}/cc_tool/projects.json
# (0600): cc-dash shows a permission request only from a registered project's hook.
python3 - "$CC_TOOL_DIR" "$PROJECT_DIR" "$RESET_TERMINALS" <<'EOF'
import importlib.util, json, os, sys
root, project = os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2])
reset_terminals = sys.argv[3] == "1"
hooks = os.path.join(project, ".claude", "hooks")


def write(path, data):
    # Unchanged content is left alone: the hook requires the record to predate the running
    # dashboard (its ctime), so a no-op re-run must not force a dashboard restart.
    try:
        st = os.lstat(path)
        if os.path.isfile(path) and not os.path.islink(path) and (st.st_mode & 0o777) == 0o600:
            with open(path, encoding="utf-8") as fh:
                if fh.read() == data:
                    return
    except OSError:
        pass
    tmp = "%s.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.write(fd, data.encode())
    finally:
        os.close(fd)
    os.replace(tmp, path)
    os.chmod(path, 0o600)


write(os.path.join(hooks, "cc_tool_root"), root + "\n")
sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location("cc_procs", os.path.join(root, "templates", "hooks", "cc_procs.py"))
procs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(procs)
# The interpreter is this helper's own (`python3 -` above, found on PATH the way
# bin/cc-dash's `#!/usr/bin/env python3` finds it), by the kernel's /proc/self/exe.
python = procs.python_record()
# The terminals the control code may be shown in: whatever holds the master side of the
# terminal this runs in (its fdinfo tty-index), plus CC_DASH_TERMINALS=/path1:/path2 (only
# beside a terminal detected in this run), plus what was recorded before (kept: they are
# yours). The hook refuses a dashboard whose terminal is held by anything else.
mpath = os.path.join(hooks, procs.MANIFEST_NAME)
try:
    with open(mpath, encoding="utf-8") as fh:
        old = json.load(fh).get("terminal_hosts") or []
except (OSError, ValueError, AttributeError):
    old = []
# The same rules as `cc-dash --control` itself (procs.recording_problem): not under
# Claude Code (its variables, the claude CLI among the parents or the session and
# process-group leaders' parents, unreadable counts), no detached terminal driver, no
# fresh session after a re-parent, and a controlling pseudo-terminal of its own.
refusal = procs.recording_problem()
skipped = []
extra = [p for p in os.environ.get("CC_DASH_TERMINALS", "").split(":") if p]
if refusal:
    # Run from inside Claude Code (an agent's Bash call, maybe on a terminal of its own
    # making) or not from a terminal of yours: record nothing, keep what was recorded,
    # ignore CC_DASH_TERMINALS.
    detected, bad, terminals = [], [], old
    print("  • control mode: no terminal recorded, because %s; the recorded list is kept." % refusal)
    print("    Run cc-update-project once from the terminal you will run `ccdash --control` in to record it.")
else:
    detected = procs.detect_terminals(skipped=skipped)
    bad = [p for p in extra if procs.terminal_entry(p) is None or procs._bare(os.path.realpath(p)) in procs.NOT_RECORDABLE
           or procs.interpreter_copy(os.path.realpath(p))]
    # CC_DASH_TERMINALS adds to a terminal detected here, never stands in for one: with no
    # recordable terminal holding this one, whatever it names is not recorded either.
    named = [p for p in extra if p not in bad] if detected else []
    terminals = procs.merge_terminals([] if reset_terminals else old, (detected or []) + named)
write(mpath, json.dumps(procs.build_manifest(root, python, terminals), indent=1, sort_keys=True) + "\n")
for path, why in skipped:
    print("  • control mode: not recording %s as a terminal: %s" % (path, why))
if not refusal and not detected:
    print("  • control mode: could not see a program that may be recorded holding this terminal; nothing new recorded.")
    if extra:
        print("    CC_DASH_TERMINALS is not recorded either: it only adds to a terminal recorded in the same run.")
for p in bad:
    print("  • CC_DASH_TERMINALS: %s is not an executable file, or is a generic interpreter or terminal driver; "
          "not recorded" % p)
if reset_terminals and not refusal:
    print("  • control mode: --reset-terminals: the earlier recorded terminals were replaced")
if terminals:
    print("  • control mode: terminals recorded for the control code: " + ", ".join(t["path"] for t in terminals))
base = os.environ.get("XDG_STATE_HOME") or ""
if not os.path.isabs(base):
    base = os.path.join(os.path.expanduser("~"), ".local", "state")
state = os.path.join(base, "cc_tool")
os.makedirs(state, mode=0o700, exist_ok=True)
reg = os.path.join(state, "projects.json")
try:
    with open(reg, encoding="utf-8") as fh:
        known = json.load(fh).get("projects") or []
except (OSError, ValueError, AttributeError):
    known = []
known = sorted({p for p in known if isinstance(p, str)} | {project})
write(reg, json.dumps({"v": 1, "projects": known}, indent=1) + "\n")
EOF

# Prune hooks cc_tool used to ship and no longer does. Copying alone left them
# behind forever: cc_tool's entries in the settings.json hooks block are rebuilt
# from the template, so an orphan stops being registered but the file lingers as dead weight — and a
# reader can't tell it from a live guard. A file is only removed when cc_tool has
# shipped that exact filename at some point AND the project's copy still matches
# a version cc_tool shipped. So a project's OWN hooks (never shipped by cc_tool)
# and a locally-edited former cc_tool hook are both left alone.
python3 - "$CC_TOOL_DIR" "$PROJECT_DIR" <<'EOF'
import hashlib, subprocess, sys
from pathlib import Path

cc_tool, project = Path(sys.argv[1]), Path(sys.argv[2])
tdir, hdir = cc_tool / "templates" / "hooks", project / ".claude" / "hooks"
PREFIX = "templates/hooks/"


def git(*args):
    return subprocess.run(["git", "-C", str(cc_tool), *args],
                          capture_output=True, text=True).stdout


def blob_oid(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


# filename -> {oids cc_tool has ever shipped for it}
shipped = {}
for commit in git("log", "--all", "--format=%H", "--", PREFIX).split():
    for line in git("ls-tree", "-r", commit, "--", PREFIX).splitlines():
        meta, _, path = line.partition("\t")
        parts = meta.split()
        if len(parts) == 3 and parts[1] == "blob" and path.startswith(PREFIX):
            shipped.setdefault(path[len(PREFIX):], set()).add(parts[2])

current = {p.name for p in tdir.iterdir() if p.is_file()}
pruned, kept = [], []
for name, oids in shipped.items():
    if name in current:
        continue
    victim = hdir / name
    if not victim.is_file():
        continue
    if blob_oid(victim.read_bytes()) in oids:
        victim.unlink()
        pruned.append(name)
    else:
        kept.append(name)

if pruned:
    print("  ✓ pruned %d retired hook(s): %s" % (len(pruned), ", ".join(sorted(pruned))))
if kept:
    print("  • kept locally-modified retired hook(s), remove by hand if unwanted: %s"
          % ", ".join(sorted(kept)))
EOF

hook_count=$(find "$PROJECT_DIR/.claude/hooks" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" \) ! -name cc_hooklib.py ! -name cc_procs.py | wc -l | tr -d ' ')
echo "  ✓ .claude/hooks/ installed ($hook_count hooks)"

# ── 2. settings.json (merge hooks, preserve permissions) ────────────────────
SETTINGS_FILE="$PROJECT_DIR/.claude/settings.json"

mkdir -p "$PROJECT_DIR/.claude"

if [[ -f "$SETTINGS_FILE" ]]; then
    python3 - "$SETTINGS_FILE" "$CC_TOOL_DIR/templates/settings.json" <<'EOF'
import json, sys
settings = json.load(open(sys.argv[1]))
template = json.load(open(sys.argv[2]))
# The template's "hooks" block is the source of truth for cc_tool's OWN hooks,
# but the project may register hooks of its own and may have tuned a cc_tool
# hook's timeout (post-edit-typecheck's docstring says to). Replacing the block
# wholesale threw both away on every update. Merge instead:
#   - cc_tool entries come from the template; a matching existing entry
#     (same command) keeps the project's timeout
#   - entries whose command is not a cc_tool hook are carried over untouched
import os, re
cc_hooks = set(os.listdir(os.path.join(os.path.dirname(sys.argv[2]), "hooks")))

# Only a hook script under THIS project's .claude/hooks/ can be cc_tool's:
# $CLAUDE_PROJECT_DIR/.claude/hooks/x, or a relative .claude/hooks/x. A path
# like ~/.claude/hooks/x is the user's own global script.
_PROJ_HOOK_RE = re.compile(
    r"(?:\$\{?CLAUDE_PROJECT_DIR\}?\"?/|(?<![\w~./-])(?:\./)?)\.claude/hooks/([^\s\"']+)")

def _script(cmd):
    m = _PROJ_HOOK_RE.search(cmd or "")
    return m.group(1) if m else None

old_hooks = settings.get("hooks") or {}
old_timeout = {}
for entries in old_hooks.values():
    for e in entries or []:
        for h in e.get("hooks") or []:
            if "timeout" in h:
                old_timeout[h.get("command")] = h["timeout"]

merged = {}
for event, entries in template["hooks"].items():
    new_entries = []
    for e in entries:
        e = json.loads(json.dumps(e))
        for h in e.get("hooks") or []:
            if h.get("command") in old_timeout:
                h["timeout"] = old_timeout[h["command"]]
        new_entries.append(e)
    merged[event] = new_entries
proj_hooks_dir = os.path.join(os.path.dirname(sys.argv[1]), "hooks")
def _project_owned(h):
    s = _script(h.get("command"))
    if s is None:
        return True                      # inline command, not a hook script at all
    # not a cc_tool hook, and its script still exists (a retired cc_tool hook
    # was pruned above, so its registration must not be carried forward)
    return s not in cc_hooks and os.path.isfile(os.path.join(proj_hooks_dir, s))
# Ownership is per hook, not per entry: a project hook added inside one of
# cc_tool's own entries (same matcher) is split out into an entry of its own.
for event, entries in old_hooks.items():
    for e in entries or []:
        mine = [h for h in (e.get("hooks") or []) if _project_owned(h)]
        if mine:
            kept = {k: v for k, v in e.items() if k != "hooks"}
            kept["hooks"] = mine
            if kept not in merged.setdefault(event, []):
                merged[event].append(kept)
settings["hooks"] = merged
# Managed attribution policy (keeps Claude out of commit co-authors). Apply each
# key only where the project hasn't set its own — never clobber user overrides,
# so re-runs stay idempotent (same additive approach as the permissions merge).
tmpl_attr = template.get("attribution")
if isinstance(tmpl_attr, dict):
    attr = settings.setdefault("attribution", {})
    for k, v in tmpl_attr.items():
        attr.setdefault(k, v)
# Managed env (Opus 5.5 as the default subagent model): same rule — add a key
# only where the project hasn't set it, so a project override survives updates.
tmpl_env = template.get("env")
if isinstance(tmpl_env, dict):
    env = settings.setdefault("env", {})
    for k, v in tmpl_env.items():
        env.setdefault(k, v)
# Plan-mode files land in docs/plans (the Work view tracks them); a project's own value stays.
if isinstance(template.get("plansDirectory"), str):
    settings.setdefault("plansDirectory", template["plansDirectory"])
# Retired managed env: v0.0.19-v0.0.20 shipped SUBAGENT_MODEL_FORCE="1", which
# drops every per-call model and so blocks Sonnet 5.5 execution arms. Remove
# only that exact shipped value; any other value is the project's own choice.
env = settings.get("env")
if isinstance(env, dict) and env.get("CLAUDE_CODE_SUBAGENT_MODEL_FORCE") == "1":
    del env["CLAUDE_CODE_SUBAGENT_MODEL_FORCE"]
    print("  ✓ retired CLAUDE_CODE_SUBAGENT_MODEL_FORCE (subagents may now run on Sonnet 5.5;"
          " set it to \"true\" to keep every subagent on Opus)")
# Retired managed permission rules. cc_tool asks before installs and deletions
# and nowhere else, and bash-guard.py now makes both calls itself:
#  - ask "Bash(npx *)" (v0.0.3-v0.0.21) prompted on every `npx vitest`; the hook
#    asks only when npx would download a package that is not on disk.
#  - deny "Bash(rm -rf *)" and the git discard rules (initial-v0.0.22) refused
#    every deletion outright, scratch included, so agents routed around them or
#    handed the step back to the user. The hook asks instead, skips scratch and
#    regenerable caches, and still denies the catastrophic forms.
#  - deny "Write(path)" rules (retired in v0.1.0) never matched anything: Claude Code
#    matches only Edit(path) for file permission checks, and Edit rules cover every
#    file-editing tool. Each path keeps its Edit(path) rule, so no protection is lost;
#    the dead entries only made every session start print one warning apiece.
# Only these exact shipped strings are removed; anything a project wrote itself,
# in any other spelling, stays.
_RETIRED = {
    "ask": ["Bash(npx *)"],
    "deny": ["Bash(rm -rf *)", "Bash(rm -rf:*)", "Bash(git reset --hard *)", "Bash(git clean -fd*)",
             "Bash(git checkout .)", "Bash(git checkout -- *)", "Bash(git branch -D *)",
             "Write(~/.ssh/**)", "Write(~/.aws/**)", "Write(**/*.pem)", "Write(**/*.key)",
             "Write(**/id_rsa*)", "Write(~/.config/gcloud/**)"],
}
perms = settings.get("permissions")
for section, retired in _RETIRED.items():
    rules = perms.get(section) if isinstance(perms, dict) else None
    gone = [r for r in retired if isinstance(rules, list) and r in rules]
    if gone:
        perms[section] = [r for r in rules if r not in gone]
        print("  ✓ retired %s rule(s) (replaced by bash-guard.py, or never matched by Claude Code): %s"
              % (section, ", ".join(gone)))
open(sys.argv[1], "w").write(json.dumps(settings, indent=2) + "\n")
print("  ✓ .claude/settings.json hooks + attribution + env updated (permissions preserved)")
EOF
else
    cp "$CC_TOOL_DIR/templates/settings.json" "$SETTINGS_FILE"
    echo "  ✓ .claude/settings.json created"
fi

# ── 2b. Workflows safety precondition ────────────────────────────────────────
# Workflow-spawned subagents run in acceptEdits and inherit the allowlist, so
# the deterministic bash-guard.py PreToolUse hook — not a permission prompt —
# is what gates protected-branch git writes mid-run. Warn when workflows are
# enabled without that hook able to fire.
if ! command -v python3 &>/dev/null; then
    echo "  ⚠ python3 not found — all .py hooks (incl. bash-guard.py, the enforced"
    echo "    protected-branch gate under native workflows) FAIL OPEN without it."
    echo "    Install python3, or set \"disableWorkflows\": true in .claude/settings.json."
else
    python3 - "$SETTINGS_FILE" <<'EOF'
import json, sys
try:
    settings = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if settings.get("disableWorkflows"):
    sys.exit(0)
entries = (settings.get("hooks") or {}).get("PreToolUse") or []
for entry in entries:
    if "Bash" not in str(entry.get("matcher", "")):
        continue
    for h in entry.get("hooks") or []:
        if "bash-guard.py" in str(h.get("command", "")):
            sys.exit(0)
print('  ⚠ Native workflows are enabled (no "disableWorkflows": true) but no')
print("    PreToolUse Bash hook invokes bash-guard.py. Workflow subagents run in")
print("    acceptEdits and inherit the allowlist, so that hook is the enforced")
print("    boundary for protected-branch git writes mid-run. Re-run cc-setup to")
print('    install hooks, or set "disableWorkflows": true.')
EOF
fi

# ── 2c. Claude Code version for model routing ────────────────────────────────
# The managed block routes execution arms to `model: "sonnet"` and read-only
# mechanical arms to `model: "haiku"`. Before 2.1.284 "sonnet" resolves to
# Sonnet 5, and before 2.1.293 "haiku" resolves to Haiku 4.5 (on Bedrock/Vertex/
# Foundry both stay on the older models regardless). Warn only; never block setup.
CC_MIN_SONNET55="2.1.284"
CC_MIN_HAIKU55="2.1.293"
cc_ver="$(claude --version 2>/dev/null | head -1 | awk '{print $1}' || true)"
cc_older_than() { [ "$(printf '%s\n%s\n' "$1" "$cc_ver" | sort -V | head -1)" != "$1" ]; }
if [ -n "$cc_ver" ] && cc_older_than "$CC_MIN_SONNET55"; then
    echo "  ⚠ Claude Code $cc_ver: the \"sonnet\" alias still means Sonnet 5 here."
    echo "    Run \`claude update\` (Sonnet 5.5 needs $CC_MIN_SONNET55+) before relying on"
    echo "    the Sonnet execution arms in the managed block's Model routing."
elif [ -n "$cc_ver" ] && cc_older_than "$CC_MIN_HAIKU55"; then
    echo "  ⚠ Claude Code $cc_ver: the \"haiku\" alias still means Haiku 4.5 here."
    echo "    Run \`claude update\` (Haiku 5.5 needs $CC_MIN_HAIKU55+) before relying on"
    echo "    the Haiku read-only arms in the managed block's Model routing."
fi

# ── 3. Skills ────────────────────────────────────────────────────────────────
# New skill directories are copied in. An EXISTING directory is refreshed only
# when its content still matches some version of the template in cc_tool's git
# history — i.e. nobody edited it locally. A directory that matches no shipped
# version is left alone and reported, so local edits are never clobbered.
#
# Skipping at directory level (the behaviour before this) meant every edit to an
# existing skill's SKILL.md or references/ was invisible to already-configured
# projects forever — only brand-new skill directories ever propagated.
SKILLS_TEMPLATE_DIR="$CC_TOOL_DIR/templates/skills"
if [[ -d "$SKILLS_TEMPLATE_DIR" ]]; then
    mkdir -p "$PROJECT_DIR/.claude/skills"
    python3 - "$CC_TOOL_DIR" "$PROJECT_DIR" <<'EOF'
import hashlib, shutil, subprocess, sys
from pathlib import Path

cc_tool, project = Path(sys.argv[1]), Path(sys.argv[2])
tdir, sdir = cc_tool / "templates" / "skills", project / ".claude" / "skills"

IGNORE = {"__pycache__", ".DS_Store"}


def blob_oid(data: bytes) -> str:
    """Git's own object id for a blob, so working-tree files and tree entries
    can be compared without materialising anything from history."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def snapshot(root: Path) -> dict[str, str]:
    return {
        str(p.relative_to(root)): blob_oid(p.read_bytes())
        for p in sorted(root.rglob("*"))
        if p.is_file() and not IGNORE & set(p.parts)
    }


def git(*args: str) -> str:
    return subprocess.run(
        ["git", "-C", str(cc_tool), *args], capture_output=True, text=True
    ).stdout


def shipped_versions(name: str):
    """Every version of templates/skills/<name>/ this repo has ever shipped."""
    prefix = f"templates/skills/{name}/"
    for commit in git("log", "--format=%H", "--", prefix).split():
        snap = {}
        for line in git("ls-tree", "-r", commit, prefix).splitlines():
            meta, _, path = line.partition("\t")
            parts = meta.split()
            if len(parts) == 3 and parts[1] == "blob":
                snap[path[len(prefix):]] = parts[2]
        if snap:
            yield snap


installed = refreshed = current = local = 0
local_names: list[str] = []

for skill_src in sorted(p for p in tdir.iterdir() if p.is_dir()):
    name = skill_src.name
    dst = sdir / name
    if not dst.is_dir():
        shutil.copytree(skill_src, dst)
        installed += 1
        continue

    want, have = snapshot(skill_src), snapshot(dst)
    up_to_date = all(have.get(k) == oid for k, oid in want.items())
    extras = set(have) - set(want)
    if up_to_date and not extras:
        current += 1
        continue

    # An extra file is stale only if cc_tool once shipped it; anything else is a
    # local addition and stays. Without this split, a skill carrying a local
    # extra would re-report as "refreshed" on every run and never settle.
    versions = list(shipped_versions(name))
    stale = extras & set().union(*versions) if versions else set()
    if up_to_date and not stale:
        current += 1
        continue

    # Unmodified copy of an older release? Every file that version shipped must
    # still be byte-identical here.
    if not any(all(have.get(k) == oid for k, oid in v.items()) for v in versions):
        local += 1
        local_names.append(name)
        continue

    for rel in want:
        target = dst / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(skill_src / rel, target)
    for rel in stale:
        (dst / rel).unlink(missing_ok=True)
    refreshed += 1

# Skills cc_tool no longer ships. A project copy goes only when it is byte-identical,
# file for file, to a version cc_tool once shipped: an edited copy, an extra file, a
# symlink, or a user's own skill that reuses the name all stay.
RETIRED_SKILLS = ("skills-audit", "dynamic-workflows", "e2e-testing", "ui-ux-review", "frontend-review")
pruned = 0
kept_retired: list[str] = []
for name in RETIRED_SKILLS:
    dst = sdir / name
    if not dst.is_dir():
        continue
    if not dst.is_symlink() and not any(q.is_symlink() for q in dst.rglob("*")) and snapshot(dst) in list(shipped_versions(name)):
        shutil.rmtree(dst)
        pruned += 1
    else:
        kept_retired.append(name)

parts = [f"installed {installed}", f"refreshed {refreshed}", f"already current {current}"]
if pruned:
    parts.append(f"pruned {pruned} retired")
if local:
    parts.append(f"locally modified {local}")
print("  ✓ .claude/skills/ — " + ", ".join(parts))
if local_names:
    print("    ℹ Left untouched (content matches no shipped version — local edits):")
    for n in local_names:
        print(f"      - {n}")
    print("    Delete the project copy to pick up the current template.")
for n in kept_retired:
    print(f"    ℹ Left untouched: .claude/skills/{n} (retired skill, but its content is not an unmodified shipped copy)")
EOF
fi

# ── 4. CLAUDE.md ─────────────────────────────────────────────────────────────
CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"
SNIPPET="$CC_TOOL_DIR/templates/CLAUDE_snippet.md"
TEMPLATE="$CC_TOOL_DIR/templates/CLAUDE_template.md"

inject_snippet() {
    if [[ ! -f "$CLAUDE_MD" ]]; then
        { cat "$TEMPLATE"; echo; cat "$SNIPPET"; } > "$CLAUDE_MD"
        echo "  ✓ CLAUDE.md created (project template + agent guidance)"
        echo "    Fill in placeholders marked with <!-- --> before committing"
        return
    fi
    # Existing CLAUDE.md: replace the cc_tool-managed snippet block in place.
    # Idempotent — preserves all project-specific content, never duplicates.
    python3 - "$CLAUDE_MD" "$SNIPPET" <<'EOF'
import sys

claude_path, snippet_path = sys.argv[1], sys.argv[2]
content = open(claude_path, encoding="utf-8").read()
snippet = open(snippet_path, encoding="utf-8").read().strip()

START = "<!-- cc_tool:snippet:start"
END = "<!-- cc_tool:snippet:end -->"

if START in content and END in content:
    # Preferred path: replace exactly between the managed markers.
    pre = content[: content.index(START)]
    post = content[content.index(END) + len(END):]
    # One blank line on each side of the block, whatever was there before, so
    # a re-run is byte-identical.
    tail = "\n" + post.lstrip("\n") if post.strip() else ""
    new = (pre.rstrip() + "\n\n" if pre.strip() else "") + snippet + "\n" + tail
    action = "updated (managed block replaced)"
elif "## AI agent tools" in content:
    # Legacy: snippet was appended without markers and is the trailing block.
    # Replace from that heading to EOF; migrates the file to use markers.
    pre = content[: content.index("## AI agent tools")]
    new = pre.rstrip() + "\n\n" + snippet + "\n"
    action = "updated (migrated to managed markers)"
else:
    # No cc_tool snippet present yet — append it.
    new = content.rstrip() + "\n\n" + snippet + "\n"
    action = "appended"

open(claude_path, "w", encoding="utf-8").write(new)
print(f"  ✓ CLAUDE.md agent guidance {action}")
EOF
}

echo ""
# `|| …=Y`: with no terminal and nothing piped in (Claude's Bash tool, cron, CI)
# `read` hits EOF and would abort under set -e before the CLAUDE.md block. A
# piped answer ("n") is still honoured.
read -p "Inject/update agent guidance in CLAUDE.md (superpowers + orchestration + critical rules)? [Y/n] " inject_confirm || inject_confirm=Y
if [[ ! "$inject_confirm" =~ ^[Nn]$ ]]; then
    inject_snippet
fi

# ── 4b. .gitignore: taste-skill's working folder ─────────────────────────────
# design-taste-frontend v2 writes its dealt direction, inspector screenshots and
# critique into .taste-skill/ at the project root; regenerable, never source.
# (Its credited pictures go to assets/, which stays tracked.)
GITIGNORE="$PROJECT_DIR/.gitignore"
if [[ -f "$GITIGNORE" ]] && grep -qxE '/?\.taste-skill/?' "$GITIGNORE"; then
    echo "  ✓ .taste-skill/ already in .gitignore"
else
    [[ -s "$GITIGNORE" && -n "$(tail -c1 "$GITIGNORE")" ]] && echo >> "$GITIGNORE"
    printf '# taste-skill working files (cc_tool)\n.taste-skill/\n' >> "$GITIGNORE"
    echo "  ✓ .taste-skill/ added to .gitignore"
fi

# ── 4c. .gitignore: the run-state board ──────────────────────────────────────
# The managed block's "Run-state board": each agent of a multi-agent run keeps its
# brief, checkpoint and report under .cc-board/<run>/<label>/ in the main
# checkout. Model output about one run, never source.
if [[ -f "$GITIGNORE" ]] && grep -qxE '/?\.cc-board/?' "$GITIGNORE"; then
    echo "  ✓ .cc-board/ already in .gitignore"
else
    [[ -s "$GITIGNORE" && -n "$(tail -c1 "$GITIGNORE")" ]] && echo >> "$GITIGNORE"
    printf '# run-state board of multi-agent runs (cc_tool)\n.cc-board/\n' >> "$GITIGNORE"
    echo "  ✓ .cc-board/ added to .gitignore"
fi

# ── Done ─────────────────────────────────────────────────────────────────────
echo ""
echo "Done! What's active in this project:"
echo ""
echo "  Hooks                  — session context, bash-guard (branch/push/--no-verify/"
echo "                           secret reads/destructive commands), write-guard (system"
echo "                           paths, secrets in content, stale reads), big-file warning,"
echo "                           context-usage, post-edit typecheck, activity log"
echo "                           (.git/cc_tool/activity.jsonl); project rules in"
echo "                           .claude/guard-rules.json (distill-rules skill)"
skill_count=$(find "$CC_TOOL_DIR/templates/skills" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
echo "  Skills                 — $skill_count in .claude/skills/ (add more to cc_tool/templates/skills/ to auto-deploy)"
echo ""
echo "  Superpowers skills     — active if installed globally"
echo "                           install once: cc-install-superpowers"
echo "                           update:       cc-update"

# ── 5. Optional self-writing vault ───────────────────────────────────────────
if (( WITH_VAULT )); then
    echo ""
    echo "── Vault ───────────────────────────────────────────────────────────"
    "$CC_TOOL_DIR/bin/cc-vault" "$PROJECT_DIR"
fi

# ── 5b. Optional software factory ────────────────────────────────────────────
FACTORY_MARKER="$PROJECT_DIR/.claude/no-factory"
if (( NO_FACTORY )); then
    echo ""
    if [[ -L "$PROJECT_DIR/.claude" ]]; then
        echo "factory: .claude is a symlink; marker not written (replace it with a real directory)"
    elif [[ -L "$FACTORY_MARKER" ]]; then
        echo "factory: .claude/no-factory is a symlink; marker not written (remove the link)"
    else
        mkdir -p "$PROJECT_DIR/.claude"
        # noclobber makes the redirect O_EXCL: an existing marker stays as it is, a racing symlink is not followed.
        if [[ -e "$FACTORY_MARKER" ]] || ( set -o noclobber; : > "$FACTORY_MARKER" ) 2>/dev/null; then
            echo "factory skipped: --no-factory (recorded in .claude/no-factory; --factory removes it)"
            [[ -e "$PROJECT_DIR/factory/line.json" ]] \
                && echo "factory: factory/line.json already exists, so the scaffold stays and routing stays on until you remove factory/line.json"
        else
            echo "factory: .claude/no-factory could not be created; marker not written"
        fi
    fi
elif (( WITH_FACTORY )); then
    # rm -f removes a symlink itself, never its target; a symlinked .claude/ is not entered.
    [[ -L "$PROJECT_DIR/.claude" ]] || rm -f "$FACTORY_MARKER"
    echo ""
    echo "── Factory ─────────────────────────────────────────────────────────"
    "$CC_TOOL_DIR/bin/cc-factory" init "$PROJECT_DIR"
elif [[ -e "$FACTORY_MARKER" || -L "$FACTORY_MARKER" ]]; then
    echo ""
    echo "factory skipped: .claude/no-factory exists (run cc-setup --factory to turn it on)"
# CC_SETUP_PROC_STATUS is a test-only stand-in for /proc/self/status.
elif [[ ! -r "${CC_SETUP_PROC_STATUS:-/proc/self/status}" ]]; then
    echo ""
    echo "factory skipped: its gates need Linux /proc; this project stays on Superpowers"
elif ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo ""
    echo "factory skipped: not a git work tree (git init, then re-run cc-setup)"
elif FACTORY_TOP="$(git -C "$PROJECT_DIR" rev-parse --show-toplevel 2>/dev/null)" \
        && [[ "$(realpath "$FACTORY_TOP")" != "$(realpath "$PROJECT_DIR")" ]]; then
    # Default-on must not write above the directory it was run in (a monorepo package, a dotfiles repo in $HOME).
    echo ""
    echo "factory skipped: $PROJECT_DIR is inside the git repository $FACTORY_TOP; run cc-setup there, or pass --factory"
elif FACTORY_COMMON="$(git -C "$PROJECT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
        && [[ -e "$(dirname "$FACTORY_COMMON")/.claude/no-factory" || -L "$(dirname "$FACTORY_COMMON")/.claude/no-factory" ]]; then
    # A linked worktree honours the opt-out recorded at the main checkout.
    echo ""
    echo "factory skipped: .claude/no-factory exists in the main checkout (run cc-setup --factory to turn it on)"
else
    echo ""
    echo "── Factory ─────────────────────────────────────────────────────────"
    "$CC_TOOL_DIR/bin/cc-factory" init "$PROJECT_DIR" \
        || echo "  ⚠ factory scaffold failed; setup continues (re-run: cc-factory init, or cc-setup --no-factory to opt out)"
fi

# ── 6. Optional devcontainer setup ──────────────────────────────────────────
if (( WITH_DEVCONTAINER )); then
    echo ""
    echo "── Devcontainer ────────────────────────────────────────────────────"
    "$CC_TOOL_DIR/bin/cc-devcontainer" "$PROJECT_DIR" "${DEVCONTAINER_ARGS[@]}"
fi
