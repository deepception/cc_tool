#!/usr/bin/env bash
# cc-setup: Configure Claude Code tools (hooks + settings + skills + CLAUDE.md) in a project.
# Usage: cc-setup [project_path] [--vault] [--devcontainer [--cloud aws|gcp|none] [--firewall on|off]]
set -euo pipefail

CC_TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROJECT_DIR=""
WITH_DEVCONTAINER=0
WITH_VAULT=0
DEVCONTAINER_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --vault) WITH_VAULT=1; shift ;;
        --devcontainer) WITH_DEVCONTAINER=1; shift ;;
        --cloud|--cloud=*|--firewall|--firewall=*|--force)
            DEVCONTAINER_ARGS+=("$1")
            # Consume the value too if it's a separate arg
            case "$1" in
                --cloud|--firewall) DEVCONTAINER_ARGS+=("${2:-}"); shift 2 ;;
                *) shift ;;
            esac
            ;;
        -*) echo "Unknown flag: $1" >&2; exit 1 ;;
        *)  PROJECT_DIR="$1"; shift ;;
    esac
done

PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"
PROJECT_DIR="$(realpath "$PROJECT_DIR")"

# ── Validation ──────────────────────────────────────────────────────────────
if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "Error: '$PROJECT_DIR' does not exist." >&2
    exit 1
fi

echo "Setting up Claude Code tools in: $PROJECT_DIR"
echo ""

# cc_tool no longer manages .mcp.json — it ships no MCP server of its own.
# A project that wants one adds it directly, or with `claude mcp add`.

# ── 1. Hook scripts ───────────────────────────────────────────────────────────
mkdir -p "$PROJECT_DIR/.claude/hooks"
find "$CC_TOOL_DIR/templates/hooks" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" \) \
    -exec cp {} "$PROJECT_DIR/.claude/hooks/" \;
find "$PROJECT_DIR/.claude/hooks" -maxdepth 1 -name "*.sh" -exec chmod +x {} \;
hook_count=$(find "$PROJECT_DIR/.claude/hooks" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" \) | wc -l | tr -d ' ')
echo "  ✓ .claude/hooks/ installed ($hook_count hooks)"

# ── 2. settings.json (merge hooks, preserve permissions) ────────────────────
SETTINGS_FILE="$PROJECT_DIR/.claude/settings.json"

mkdir -p "$PROJECT_DIR/.claude"

if [[ -f "$SETTINGS_FILE" ]]; then
    python3 - "$SETTINGS_FILE" "$CC_TOOL_DIR/templates/settings.json" <<'EOF'
import json, sys
settings = json.load(open(sys.argv[1]))
template = json.load(open(sys.argv[2]))
# The template's own "hooks" block is the single source of truth — no second copy to drift.
settings["hooks"] = template["hooks"]
# Managed attribution policy (keeps Claude out of commit co-authors). Apply each
# key only where the project hasn't set its own — never clobber user overrides,
# so re-runs stay idempotent (same additive approach as the permissions merge).
tmpl_attr = template.get("attribution")
if isinstance(tmpl_attr, dict):
    attr = settings.setdefault("attribution", {})
    for k, v in tmpl_attr.items():
        attr.setdefault(k, v)
open(sys.argv[1], "w").write(json.dumps(settings, indent=2) + "\n")
print("  ✓ .claude/settings.json hooks + attribution updated (permissions preserved)")
EOF
else
    cp "$CC_TOOL_DIR/templates/settings.json" "$SETTINGS_FILE"
    echo "  ✓ .claude/settings.json created"
fi

# ── 2b. Workflows safety precondition ────────────────────────────────────────
# Workflow-spawned subagents run in acceptEdits and inherit the allowlist, so
# the deterministic bash-guard.py PreToolUse hook — not a permission prompt —
# is what gates protected-branch git writes mid-run. Warn when workflows are
# enabled without that hook able to fire.
if ! command -v python3 &>/dev/null; then
    echo "  ⚠ python3 not found — all .py hooks (incl. bash-guard.py, the enforced"
    echo "    protected-branch gate under native workflows) FAIL OPEN without it."
    echo "    Install python3, or set \"disableWorkflows\": true in .claude/settings.json."
else
    python3 - "$SETTINGS_FILE" <<'EOF'
import json, sys
try:
    settings = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if settings.get("disableWorkflows"):
    sys.exit(0)
entries = (settings.get("hooks") or {}).get("PreToolUse") or []
for entry in entries:
    if "Bash" not in str(entry.get("matcher", "")):
        continue
    for h in entry.get("hooks") or []:
        if "bash-guard.py" in str(h.get("command", "")):
            sys.exit(0)
print('  ⚠ Native workflows are enabled (no "disableWorkflows": true) but no')
print("    PreToolUse Bash hook invokes bash-guard.py. Workflow subagents run in")
print("    acceptEdits and inherit the allowlist, so that hook is the enforced")
print("    boundary for protected-branch git writes mid-run. Re-run cc-setup to")
print('    install hooks, or set "disableWorkflows": true.')
EOF
fi

# ── 3. Skills ────────────────────────────────────────────────────────────────
SKILLS_TEMPLATE_DIR="$CC_TOOL_DIR/templates/skills"
if [[ -d "$SKILLS_TEMPLATE_DIR" ]]; then
    mkdir -p "$PROJECT_DIR/.claude/skills"
    installed=0
    skipped=0
    for skill_src in "$SKILLS_TEMPLATE_DIR"/*/; do
        skill_name="$(basename "$skill_src")"
        skill_dst="$PROJECT_DIR/.claude/skills/$skill_name"
        if [[ -d "$skill_dst" ]]; then
            (( skipped++ )) || true
        else
            cp -r "$skill_src" "$skill_dst"
            (( installed++ )) || true
        fi
    done
    echo "  ✓ .claude/skills/ — installed $installed, skipped $skipped (already present)"
fi

# ── 4. CLAUDE.md ─────────────────────────────────────────────────────────────
CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"
SNIPPET="$CC_TOOL_DIR/templates/CLAUDE_snippet.md"
TEMPLATE="$CC_TOOL_DIR/templates/CLAUDE_template.md"

inject_snippet() {
    if [[ ! -f "$CLAUDE_MD" ]]; then
        cat "$TEMPLATE" "$SNIPPET" > "$CLAUDE_MD"
        echo "  ✓ CLAUDE.md created (project template + agent guidance)"
        echo "    Fill in placeholders marked with <!-- --> before committing"
        return
    fi
    # Existing CLAUDE.md: replace the cc_tool-managed snippet block in place.
    # Idempotent — preserves all project-specific content, never duplicates.
    python3 - "$CLAUDE_MD" "$SNIPPET" <<'EOF'
import sys

claude_path, snippet_path = sys.argv[1], sys.argv[2]
content = open(claude_path, encoding="utf-8").read()
snippet = open(snippet_path, encoding="utf-8").read().strip()

START = "<!-- cc_tool:snippet:start"
END = "<!-- cc_tool:snippet:end -->"

if START in content and END in content:
    # Preferred path: replace exactly between the managed markers.
    pre = content[: content.index(START)]
    post = content[content.index(END) + len(END):]
    new = pre.rstrip() + "\n\n" + snippet + "\n" + post.lstrip("\n")
    action = "updated (managed block replaced)"
elif "## AI agent tools" in content:
    # Legacy: snippet was appended without markers and is the trailing block.
    # Replace from that heading to EOF; migrates the file to use markers.
    pre = content[: content.index("## AI agent tools")]
    new = pre.rstrip() + "\n\n" + snippet + "\n"
    action = "updated (migrated to managed markers)"
else:
    # No cc_tool snippet present yet — append it.
    new = content.rstrip() + "\n\n" + snippet + "\n"
    action = "appended"

open(claude_path, "w", encoding="utf-8").write(new)
print(f"  ✓ CLAUDE.md agent guidance {action}")
EOF
}

echo ""
read -p "Inject/update agent guidance in CLAUDE.md (superpowers + orchestration + critical rules)? [Y/n] " inject_confirm
if [[ ! "$inject_confirm" =~ ^[Nn]$ ]]; then
    inject_snippet
fi

# ── Done ─────────────────────────────────────────────────────────────────────
echo ""
echo "Done! What's active in this project:"
echo ""
echo "  Hooks                  — session context, bash-guard (branch/push/--no-verify/"
echo "                           secret reads), big-file warning, context-usage,"
echo "                           post-edit typecheck"
skill_count=$(find "$CC_TOOL_DIR/templates/skills" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
echo "  Skills                 — $skill_count in .claude/skills/ (add more to cc_tool/templates/skills/ to auto-deploy)"
echo ""
echo "  Superpowers skills     — active if installed globally"
echo "                           install once: cc-install-superpowers"
echo "                           update:       cc-update"

# ── 5. Optional self-writing vault ───────────────────────────────────────────
if (( WITH_VAULT )); then
    echo ""
    echo "── Vault ───────────────────────────────────────────────────────────"
    "$CC_TOOL_DIR/bin/cc-vault" "$PROJECT_DIR"
fi

# ── 6. Optional devcontainer setup ──────────────────────────────────────────
if (( WITH_DEVCONTAINER )); then
    echo ""
    echo "── Devcontainer ────────────────────────────────────────────────────"
    "$CC_TOOL_DIR/bin/cc-devcontainer" "$PROJECT_DIR" "${DEVCONTAINER_ARGS[@]}"
fi
