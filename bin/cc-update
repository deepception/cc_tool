#!/usr/bin/env bash
# cc-update: Update external dependencies (Superpowers plugin, installed globally).
# This does NOT touch any project. For per-project template refresh use cc-update-project.
# cc_tool templates themselves are local — edit in place, then run cc-update-project.
# Ruflo needs no update action — npx -y auto-fetches latest on every session start.
set -euo pipefail

echo "Updating Superpowers plugin..."

if ! command -v claude &>/dev/null; then
    echo "⚠️  'claude' CLI not found — cannot update"
    exit 1
fi

# Superpowers ships via its own marketplace (superpowers-dev).
if claude plugin marketplace update superpowers-dev 2>&1 \
   && claude plugin update superpowers@superpowers-dev 2>&1; then
    echo "✓ Superpowers updated (restart Claude Code to apply)"
else
    echo "⚠️  Update failed. Try manually:"
    echo "  claude plugin marketplace update superpowers-dev"
    echo "  claude plugin update superpowers@superpowers-dev"
    exit 1
fi
