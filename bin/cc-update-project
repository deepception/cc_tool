#!/usr/bin/env bash
# cc-update-project: Update cc_tool-managed files (hooks, skills, permissions deny-list)
# in an existing project. For first-time setup use cc-setup. For external deps use cc-update.
# Usage: cc-update-project [project_path]
set -euo pipefail

CC_TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="${1:-$(pwd)}"
PROJECT_DIR="$(realpath "$PROJECT_DIR")"

if [[ ! -f "$PROJECT_DIR/.claude/settings.json" ]]; then
    echo "Error: no .claude/settings.json in $PROJECT_DIR" >&2
    echo "This doesn't look like an initialized project." >&2
    echo "Run 'cc-setup $PROJECT_DIR' first for initial setup." >&2
    exit 1
fi

echo "Updating cc_tool-managed files in: $PROJECT_DIR"
echo ""
echo "=== Step 1: refresh hooks and skills ==="
"$CC_TOOL_DIR/bin/cc-setup" "$PROJECT_DIR"

echo ""
echo "=== Step 2: merge new deny entries ==="
"$CC_TOOL_DIR/bin/cc-update-permissions" "$PROJECT_DIR"

echo ""
echo "=== Step 3: CLAUDE.md template-drift check (informational, non-destructive) ==="
CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"
TEMPLATE="$CC_TOOL_DIR/templates/CLAUDE_template.md"
if [[ -f "$CLAUDE_MD" && -f "$TEMPLATE" ]]; then
    python3 - "$TEMPLATE" "$CLAUDE_MD" <<'PYEOF'
import re, sys

template = open(sys.argv[1], encoding="utf-8").read()
claude = open(sys.argv[2], encoding="utf-8").read()

# Compare only the project-specific content — the managed snippet block is
# updated separately and carries its own headings.
START = "<!-- cc_tool:snippet:start"
if START in claude:
    claude = claude[: claude.index(START)]


def headings(text):
    out = []
    for line in text.splitlines():
        m = re.match(r"^(#{2,3})\s+(.*)", line)
        if m:
            out.append(m.group(2).strip())
    return out


tmpl = headings(template)
proj = {h.lower() for h in headings(claude)}
missing = [h for h in tmpl if h.lower() not in proj]
overlap = (len(tmpl) - len(missing)) / max(len(tmpl), 1)

if not missing:
    print("  ✓ CLAUDE.md already has every current template section")
elif overlap < 0.4:
    print("  ℹ This project's CLAUDE.md is heavily customized (few headings match the template).")
    print("    Template structural changes are NOT auto-applied. To adopt new template")
    print("    sections, review templates/CLAUDE_template.md and add them by hand.")
else:
    print("  ℹ Template sections not present in this project (adopt manually if wanted):")
    for h in missing:
        print(f"    - {h}")
PYEOF
else
    echo "  (no CLAUDE.md — skipped)"
fi

echo ""
echo "Done."
