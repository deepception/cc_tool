#!/usr/bin/env bash
# cc-update-permissions: Additively merge new deny and ask entries from the cc_tool template
# into an existing project's .claude/settings.json. Never removes or modifies existing entries.
# Usage: cc-update-permissions [project_path]
set -euo pipefail

CC_TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="${1:-$(pwd)}"
PROJECT_DIR="$(realpath "$PROJECT_DIR")"

SETTINGS_FILE="$PROJECT_DIR/.claude/settings.json"
TEMPLATE="$CC_TOOL_DIR/templates/settings.json"

if [[ ! -f "$SETTINGS_FILE" ]]; then
    echo "Error: $SETTINGS_FILE not found. Run cc-setup first." >&2
    exit 1
fi

if [[ ! -f "$TEMPLATE" ]]; then
    echo "Error: template not found at $TEMPLATE" >&2
    exit 1
fi

echo "Checking permissions in: $SETTINGS_FILE"

diff_output=$(python3 - "$SETTINGS_FILE" "$TEMPLATE" <<'PYEOF'
import json, sys
existing = json.load(open(sys.argv[1]))
template = json.load(open(sys.argv[2]))
existing_perms = existing.get("permissions", {})
template_perms = template.get("permissions", {})
for section in ("deny", "ask"):
    have = set(existing_perms.get(section, []))
    for entry in template_perms.get(section, []):
        if entry not in have:
            print(f"{section}\t{entry}")
PYEOF
)

if [[ -z "$diff_output" ]]; then
    echo "✓ Already up to date — no new deny/ask entries in template"
    exit 0
fi

deny_count=$(echo "$diff_output" | grep -c $'^deny\t' || true)
ask_count=$(echo "$diff_output" | grep -c $'^ask\t' || true)
total=$(echo "$diff_output" | wc -l | tr -d ' ')

echo ""
echo "$total new permissions available ($deny_count deny, $ask_count ask):"
if (( deny_count > 0 )); then
    echo "  deny:"
    echo "$diff_output" | awk -F'\t' '$1=="deny" {print "    + " $2}'
fi
if (( ask_count > 0 )); then
    echo "  ask:"
    echo "$diff_output" | awk -F'\t' '$1=="ask" {print "    + " $2}'
fi
echo ""
read -p "Append to $SETTINGS_FILE? [Y/n] " confirm
if [[ "$confirm" =~ ^[Nn]$ ]]; then
    echo "Aborted."
    exit 0
fi

python3 - "$SETTINGS_FILE" "$TEMPLATE" <<'PYEOF'
import json, sys
existing = json.load(open(sys.argv[1]))
template = json.load(open(sys.argv[2]))
existing.setdefault("permissions", {})
template_perms = template.get("permissions", {})
for section in ("deny", "ask"):
    existing["permissions"].setdefault(section, [])
    arr = existing["permissions"][section]
    for entry in template_perms.get(section, []):
        if entry not in arr:
            arr.append(entry)
open(sys.argv[1], "w").write(json.dumps(existing, indent=2) + "\n")
PYEOF

echo "✓ Added $total permission entries ($deny_count deny, $ask_count ask)"
