#!/usr/bin/env bash
# cc-install-superpowers: Install Superpowers as a global Claude Code plugin.
# Run this once. After installation, Superpowers skills are active in all projects.
set -euo pipefail

if ! command -v claude &>/dev/null; then
    echo "Error: 'claude' CLI not found. Install Claude Code first." >&2
    exit 1
fi

# Check if already installed
if claude plugin list 2>/dev/null | grep -q "superpowers"; then
    echo "✓ Superpowers already installed"
    echo "  To update: cc-update"
    exit 0
fi

# Ensure obra/superpowers marketplace is registered
if ! claude plugin marketplace list 2>/dev/null | grep -q "superpowers"; then
    echo "Adding obra/superpowers marketplace..."
    if ! claude plugin marketplace add obra/superpowers 2>&1; then
        echo ""
        echo "✗ Failed to add superpowers marketplace." >&2
        echo "  Try manually: claude plugin marketplace add obra/superpowers" >&2
        exit 1
    fi
fi

echo "Installing Superpowers plugin..."
if claude plugin install superpowers; then
    echo ""
    echo "✓ Superpowers installed."
    echo ""
    echo "Available skills (invoke manually by telling Claude):"
    echo "  superpowers:brainstorming              design before any code"
    echo "  superpowers:writing-plans              test-first implementation plan"
    echo "  superpowers:executing-plans            run the plan via subagents"
    echo "  superpowers:tdd                        strict red-green-refactor"
    echo "  superpowers:systematic-debugging       root-cause before any fix"
    echo "  superpowers:verification-before-completion  hard gate: run tests, read output"
    echo "  superpowers:dispatching-parallel-agents    independent tasks in parallel"
    echo "  superpowers:requesting-code-review     isolated code review subagent"
    echo "  superpowers:finishing-a-development-branch  merge/PR/discard with cleanup"
else
    echo ""
    echo "✗ Installation failed." >&2
    echo "  Try manually:" >&2
    echo "    claude plugin marketplace add obra/superpowers" >&2
    echo "    claude plugin install superpowers" >&2
    exit 1
fi
