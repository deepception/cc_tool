{
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-linter.sh"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "WebSearch",
