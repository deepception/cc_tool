FROM node:20

ARG TZ=Etc/UTC
ENV TZ="$TZ"

ARG CLOUD=none
ENV CLOUD="$CLOUD"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg sudo \
    iptables ipset iproute2 dnsutils aggregate jq \
    git gh ripgrep less python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*

RUN if [ "$CLOUD" = "aws" ]; then \
        apt-get update && apt-get install -y --no-install-recommends awscli \
        && rm -rf /var/lib/apt/lists/*; \
    elif [ "$CLOUD" = "gcp" ]; then \
        curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
          | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
        && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
          > /etc/apt/sources.list.d/google-cloud-sdk.list \
        && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Non-root user 'node' (provided by base image) gets passwordless sudo for the firewall init.
RUN echo 'node ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh' > /etc/sudoers.d/init-firewall \
 && echo 'Defaults env_keep += "CLOUD"' >> /etc/sudoers.d/init-firewall \
 && chmod 0440 /etc/sudoers.d/init-firewall

COPY init-firewall.sh /usr/local/bin/init-firewall.sh
RUN chmod +x /usr/local/bin/init-firewall.sh

# Extra MCP-specific domains the firewall should allowlist (one per line).
# Generated by cc-devcontainer from --mcp-domains; may be an empty file.
RUN mkdir -p /etc/cc-tool
COPY mcp-allowed-domains /etc/cc-tool/mcp-allowed-domains

RUN mkdir -p /etc/claude-code
COPY managed-settings.json /etc/claude-code/managed-settings.json

# Pre-create named-volume mount points with node ownership.
# Without this, Docker creates them as root on first mount and Claude Code
# can't write auth state to /home/node/.claude.
RUN mkdir -p /home/node/.claude /commandhistory \
 && chown -R node:node /home/node/.claude /commandhistory

USER node

# uv/uvx for basic-memory MCP (per cc_tool's templates/mcp.json)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && echo 'export PATH="$HOME/.local/bin:$PATH"' >> /home/node/.bashrc
ENV PATH="/home/node/.local/bin:${PATH}"

WORKDIR /workspace
