{
  "attribution": {
    "commit": ""
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  },
  "plansDirectory": "docs/plans",
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(gh api *)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa*)",
      "Edit(**/uv.lock)",
      "Edit(**/package-lock.json)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/yarn.lock)",
      "Edit(**/Cargo.lock)",
      "Edit(**/go.sum)",
      "Edit(**/poetry.lock)",
      "Edit(**/Gemfile.lock)",
      "Edit(**/composer.lock)",
      "Bash(git push --force *)",
      "Bash(git reflog expire *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.boto)",
      "Read(/etc/boto.cfg)",
      "Read(**/*service-account*.json)",
      "Read(**/*sa-key*.json)",
      "Read(**/*application_default_credentials*)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.azure/**)",
      "Read(~/.config/doctl/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.npmrc)",
      "Read(~/.config/npm/npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.gnupg/**)",
      "Read(**/.terraform/**)",
      "Read(**/terraform.tfstate)",
      "Read(**/terraform.tfstate.backup)",
      "Read(**/*secret*.tfvars*)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(pnpm dlx*)",
      "Bash(yarn add*)",
      "Bash(bun add*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(uv add*)",
      "Bash(uv pip install*)",
      "Bash(uv tool install*)",
      "Bash(uvx *)",
      "Bash(pipx install*)",
      "Bash(pipx run *)",
      "Bash(poetry add*)",
      "Bash(cargo install*)",
      "Bash(go install*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/session-context.py",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/lease\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/context-usage.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/pending\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/pending\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/lease\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 600
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/pending\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/big-file-guard.py",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/write-guard.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/route-nudge.py",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/pending\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-typecheck.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/activity-log.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/pending\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"${XDG_STATE_HOME:-$HOME/.local/state}/cc_tool/control/pending\" ] && python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dash-control.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/attention.py",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ]
  }
}
