{
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(gh api *)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Write(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Write(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.key)",
      "Edit(**/*.key)",
      "Write(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Edit(**/uv.lock)",
      "Edit(**/package-lock.json)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/yarn.lock)",
      "Edit(**/Cargo.lock)",
      "Edit(**/go.sum)",
      "Edit(**/poetry.lock)",
      "Edit(**/Gemfile.lock)",
      "Edit(**/composer.lock)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git reflog expire *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Read(~/.config/gcloud/**)",
      "Write(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.boto)",
      "Read(/etc/boto.cfg)",
      "Read(**/*service-account*.json)",
      "Read(**/*sa-key*.json)",
      "Read(**/*application_default_credentials*)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Bash(printenv*AWS*)",
      "Bash(printenv*GOOGLE*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(pnpm dlx*)",
      "Bash(yarn add*)",
      "Bash(bun add*)",
      "Bash(npx *)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(uv add*)",
      "Bash(uv pip install*)",
      "Bash(uv tool install*)",
      "Bash(uvx *)",
      "Bash(pipx install*)",
      "Bash(pipx run *)",
      "Bash(poetry add*)",
      "Bash(cargo install*)",
      "Bash(go install*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-linter.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/session-context.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/websearch-year.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/big-file-guard.py",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
